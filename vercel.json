      "destination": "/prototype/engine.js"
    },
    {
      "source": "/view.js",
      "destination": "/prototype/view.js"
    },
    {
      "source": "/app.js",
      "destination": "/prototype/app.js"
    },
    {
      "source": "/HDB_Game_v1_Source.zip",
      "destination": "/prototype/HDB_Game_v1_Source.zip"
    }
  ]
}
